# Template only. Supply real values securely; this file does not provision services.
# Environment files are not loaded automatically. See README.md.

# Application database: use a restricted runtime role, never an owner credential.
DATABASE_URL=
APP_ORIGIN=
# NODE_ENV=production
# PORT=3000

# Local development and disposable integration tests only.
LOCAL_DB_PASSWORD=
TEST_DATABASE_URL=
# STORAGE_DIR=

# Private Blob storage and authenticated HTTPS malware scanner.
STORAGE_DRIVER=
BLOB_READ_WRITE_TOKEN=
# For Neon private object storage, set STORAGE_DRIVER=neon and use the
# branch-scoped credentials provided by Neon. Never commit the values.
# NEON_STORAGE_BUCKET=assets
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=
# Synthetic-data Vercel previews only: explicitly allow uploads without a scanner.
# DEMO_ALLOW_UNSCANNED_UPLOADS=true

# Staging reset: use the new password and owner DATABASE_URL only for that
# command, and set confirmation separately for that invocation.
# DEMO_PASSWORD=
# CONFIRM_STAGING_DEMO_RESET=staging-only

# Independent operator: use a separate read-only DATABASE_URL and independently
# protected checkpoint storage, not application credentials.
# AUDIT_CHECKPOINT_FILE=
# PREVIOUS_AUDIT_CHECKPOINT=
# AUDIT_CHECKPOINT_MAX_AGE_HOURS=48
# AUDIT_MAX_BYTES=
# For audit:verify only, use this pair instead of AUDIT_CHECKPOINT_FILE.
# AUDIT_CHECKPOINT_COUNT=
# AUDIT_CHECKPOINT_HASH=

# Storage reconciliation: minimum 24 hours, default 24.
# RECONCILE_GRACE_HOURS=24
